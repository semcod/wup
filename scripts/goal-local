#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
PROJECT_VENV="${PROJECT_ROOT}/.venv"

if [[ ! -x "${PROJECT_VENV}/bin/python" ]]; then
  echo "error: missing project interpreter: ${PROJECT_VENV}/bin/python" >&2
  echo "hint: create venv and install deps first:" >&2
  echo "      python3 -m venv .venv && ./.venv/bin/pip install -e '.[dev]'" >&2
  exit 1
fi

export VIRTUAL_ENV="${PROJECT_VENV}"
export PATH="${PROJECT_VENV}/bin:${PATH}"
hash -r 2>/dev/null || true

if [[ $# -eq 0 ]]; then
  set -- -a
fi

GOAL_BIN="${GOAL_BIN:-}"
if [[ -z "${GOAL_BIN}" ]]; then
  GOAL_BIN="$(command -v goal || true)"
fi

if [[ -z "${GOAL_BIN}" ]]; then
  echo "error: goal binary not found in PATH" >&2
  exit 127
fi

exec "${GOAL_BIN}" "$@"
